# ─────────────────────────────────────────────────────────────
# OVOT Backend 환경변수 예시
# 이 파일을 복사해서 .env 로 저장한 뒤 실제 값을 채워 넣으세요.
#   PowerShell:  Copy-Item .env.example .env
# .env 는 .gitignore 에 등록되어 있으므로 Git 에 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 접속 정보
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ovot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=여기에_실제_비밀번호_입력

# 웹사이트 GUI(프런트엔드) 출처 목록. 쉼표로 구분.
# 와일드카드(*) 는 사용하지 않습니다.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# FastAPI 서버 설정
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# ── AI 음성 처리 (모두 선택 — 생략 시 아래 기본값) ──
# AI_ENABLED=true
# AI_PRELOAD=true              # 서버 기동 시 모델 로딩 (false 면 첫 요청 때 로딩)
# AI_DEVICE=auto               # CRN: auto | cuda | cpu
# WHISPER_MODEL=medium
# WHISPER_DEVICE=cpu           # cuda 는 cuDNN/cuBLAS DLL 필요
# AI_MAX_CONCURRENT=1
# AI_QUEUE_TIMEOUT_SEC=300
# AUDIO_MAX_UPLOAD_MB=50
# AUDIO_MAX_DURATION_SEC=600
